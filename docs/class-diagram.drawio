<mxfile host="app.diagrams.net"><diagram id="snap2stock-class" name="クラス図（現行実装）"><mxGraphModel dx="1600" dy="1700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="1750" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Snap2Stock クラス図 — 現在の実装&lt;/b&gt;&lt;br&gt;型・React関数コンポーネント・外部依存をUML形式で表現（2026-09-30）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1400" height="55" as="geometry"/></mxCell><mxCell id="App" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;App｜在庫・画面管理&lt;/b&gt;&lt;br&gt;«React component»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ vehicles: Vehicle[]&lt;br&gt;+ activeTab: Tab&lt;br&gt;+ selectedVehicleId: string | null&lt;br&gt;+ assignmentVehicleId: string | null&lt;hr&gt;+ handleUpsertVehicle(vehicle)&lt;br&gt;+ importVehicles(newVehicles)&lt;br&gt;+ updateZone(id, newZone)&lt;br&gt;+ deleteVehicle(id): boolean&lt;br&gt;+ handleStartAssignment(vehicle)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="350" height="295" as="geometry"/></mxCell><mxCell id="Vehicle" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Vehicle｜車両&lt;/b&gt;&lt;br&gt;«TypeScript interface»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ id: string&lt;br&gt;+ Zone: string&lt;br&gt;+ DateOfReceipt: string&lt;br&gt;+ CompanyName: string&lt;br&gt;+ Automaker: string&lt;br&gt;+ ModelOfCar: string&lt;br&gt;+ VIN: string&lt;br&gt;+ Year: string&lt;br&gt;+ Color: string&lt;br&gt;+ NumberPlate: string&lt;br&gt;+ Destination: string&lt;br&gt;+ Document: string&lt;br&gt;+ ShippingDate: string&lt;br&gt;+ Note: string&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1050" y="85" width="325" height="425" as="geometry"/></mxCell><mxCell id="Storage" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;localStorage｜ブラウザ保存&lt;/b&gt;&lt;br&gt;«Browser API»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ key = yard_manager_vehicles&lt;br&gt;+ value = JSON.stringify(vehicles)&lt;hr&gt;+ getItem(key)&lt;br&gt;+ setItem(key, value)&lt;br&gt;+ removeItem(key)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="110" y="110" width="320" height="200" as="geometry"/></mxCell><mxCell id="Dashboard" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Dashboard｜概要・Excel取込&lt;/b&gt;&lt;br&gt;«React component»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ vehicles: Vehicle[]&lt;hr&gt;+ handleFileUpload(event)&lt;br&gt;+ formatDate(value)&lt;br&gt;+ onImportVehicles(data) : callback&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="315" height="190" as="geometry"/></mxCell><mxCell id="StockView" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;StockView｜在庫一覧&lt;/b&gt;&lt;br&gt;«React component»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ vehicles: Vehicle[]&lt;br&gt;+ viewMode: list | map&lt;br&gt;+ filters&lt;br&gt;+ highlightedVin: string | undefined&lt;hr&gt;+ openQrModal(event, vehicle)&lt;br&gt;+ onViewDetail(id) : callback&lt;br&gt;+ onDeleteVehicle(id) : callback&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="500" width="325" height="235" as="geometry"/></mxCell><mxCell id="InboundMapFlow" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;InboundMapFlow｜入庫・配置&lt;/b&gt;&lt;br&gt;«React component»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ vehicles: Vehicle[]&lt;br&gt;+ presetVehicle?: Vehicle&lt;br&gt;+ selectedSlot: string | null&lt;hr&gt;+ handleSlotClick(zone)&lt;br&gt;+ onInboundComplete(v) : callback&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="830" y="550" width="325" height="210" as="geometry"/></mxCell><mxCell id="MobileScanner" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;MobileScanner｜車両認識・移動&lt;/b&gt;&lt;br&gt;«React component»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ vehicles: Vehicle[]&lt;br&gt;+ detectedVehicle: Vehicle | null&lt;br&gt;+ newZone: string&lt;hr&gt;+ handleCapture(event)&lt;br&gt;+ handleUpdate()&lt;br&gt;+ onUpdateZone(id, zone) : callback&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1220" y="550" width="340" height="220" as="geometry"/></mxCell><mxCell id="TodayOutboundList" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;TodayOutboundList｜本日出庫予定&lt;/b&gt;&lt;br&gt;«React component»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ vehicles: Vehicle[]&lt;br&gt;+ outboundToday: Vehicle[]&lt;hr&gt;+ handleCompleteShipment(event, id)&lt;br&gt;+ onViewDetail(id) : callback&lt;br&gt;+ onDeleteVehicle(id) : callback&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="845" width="335" height="210" as="geometry"/></mxCell><mxCell id="VehicleDetail" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;VehicleDetail｜詳細・QR印刷&lt;/b&gt;&lt;br&gt;«React component»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ vehicle: Vehicle&lt;br&gt;+ qrData: string&lt;hr&gt;+ onDelete(id) : callback&lt;br&gt;+ onStartAssignment(vehicle) : callback&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="1150" width="335" height="190" as="geometry"/></mxCell><mxCell id="YardMap" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;YardMap｜配置の可視化&lt;/b&gt;&lt;br&gt;«React component»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ vehicles: Vehicle[]&lt;br&gt;+ highlightedVin?: string&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="850" width="305" height="150" as="geometry"/></mxCell><mxCell id="VehicleForm" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;VehicleForm｜車両入力・AI補助&lt;/b&gt;&lt;br&gt;«React component»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ formData: Partial&amp;lt;Vehicle&amp;gt;&lt;br&gt;+ initialZone?: string&lt;br&gt;+ presetVehicle?: Vehicle&lt;hr&gt;+ selectUnassigned(v)&lt;br&gt;+ handleAIAnalysis(event)&lt;br&gt;+ handleSubmit(event)&lt;br&gt;+ onSubmit(vehicle) : callback&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="830" y="870" width="325" height="250" as="geometry"/></mxCell><mxCell id="Gemini" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;GoogleGenAI｜Gemini API&lt;/b&gt;&lt;br&gt;«External SDK / service»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ model = gemini-3-flash-preview&lt;hr&gt;+ models.generateContent(request)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1220" y="920" width="340" height="150" as="geometry"/></mxCell><mxCell id="QR" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;QR画像生成｜api.qrserver.com&lt;/b&gt;&lt;br&gt;«External HTTP service»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ payload = yard-v2:ID|VIN|MAKER|MODEL&lt;hr&gt;+ GET /v1/create-qr-code/&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="1170" width="340" height="150" as="geometry"/></mxCell><mxCell id="Utils" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;utils｜在庫・ゾーン関数&lt;/b&gt;&lt;br&gt;«Module»&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;hr&gt;+ upsertVehicle(vehicles, vehicle)&lt;br&gt;+ isValidZone(zone): boolean&lt;br&gt;+ isUnassigned(vehicle): boolean&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e1d5e7;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="830" y="1220" width="325" height="165" as="geometry"/></mxCell><mxCell id="edge0" value="0..* 車両を保持" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="App" target="Vehicle"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge1" value="読み込み・保存" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="App" target="Storage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="描画・props / callback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="App" target="Dashboard"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="描画・props / callback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="App" target="StockView"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="描画・props / callback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="App" target="InboundMapFlow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="描画・props / callback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="App" target="MobileScanner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="描画・props / callback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="App" target="TodayOutboundList"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge7" value="描画・props / callback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="App" target="VehicleDetail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge8" value="描画・props" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="StockView" target="YardMap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge9" value="描画・props" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="InboundMapFlow" target="VehicleForm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge10" value="写真から入力補助" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="VehicleForm" target="Gemini"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge11" value="QR / VIN 画像認識" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="MobileScanner" target="Gemini"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge12" value="QR画像取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="VehicleDetail" target="QR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge13" value="QR画像取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="StockView" target="QR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge14" value="upsertVehicle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="App" target="Utils"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge15" value="isUnassigned" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="VehicleForm" target="Utils"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge16" value="isUnassigned" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#64748b;" edge="1" parent="1" source="VehicleDetail" target="Utils"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;凡例と実装上の前提&lt;/b&gt;&lt;br&gt;青: Reactコンポーネント　緑: データ型　黄: 外部依存　紫: 関数モジュール&lt;br&gt;実線: データの関連　破線: 利用・描画の依存。callbackは子からAppへ操作を通知。&lt;br&gt;Zoneは文字列。ヤードは定数 YARD_COLS=A〜J / YARD_ROWS=1〜10 の100区画。独立したZoneクラスは存在しない。&lt;br&gt;本日出庫予定は ShippingDate が本日と一致する車両。出庫完了は削除であり履歴保存はない。&lt;br&gt;VehicleStatus / MasterDataState はtypes.tsに定義済みだが現在の処理では未使用のため関係図から省略。&lt;br&gt;スキャナーの照合処理はID/VINが対象（プロンプトはナンバープレートの認識も要求）。&lt;br&gt;バックエンド・DB・ユーザー認証のクラスは現状存在しない。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="1450" width="1500" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
