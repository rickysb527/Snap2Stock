<mxfile host="app.diagrams.net"><diagram id="snap2stock-architecture" name="システム構成・技術スタック"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1380" pageHeight="1250" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Snap2Stock｜システム構成・技術スタック&lt;/b&gt;&lt;br&gt;現行実装：ブラウザで在庫を管理し、画像解析・QR生成は外部APIを利用" style="text;html=1;align=left;fontSize=22;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1250" height="65" as="geometry"/></mxCell><mxCell id="browser" value="利用者のブラウザ（PC / スマートフォン）" style="rounded=1;arcSize=4;html=1;fillColor=#f8fafc;strokeColor=#93c5fd;dashed=1;align=left;verticalAlign=top;spacing=15;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="105" width="570" height="780" as="geometry"/></mxCell><mxCell id="external" value="外部サービス" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="970" y="75" width="365" height="590" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;利用者&lt;/b&gt;&lt;br&gt;&lt;br&gt;事務所PC・現場スマートフォン" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#e2e8f0;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="35" y="155" width="250" height="100" as="geometry"/></mxCell><mxCell id="excel" value="&lt;b&gt;Excel / CSV&lt;/b&gt;&lt;br&gt;&lt;br&gt;既存マスターデータ&lt;br&gt;.xlsx / .xls / .csv" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#dcfce7;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="35" y="335" width="250" height="110" as="geometry"/></mxCell><mxCell id="photo" value="&lt;b&gt;撮影・画像選択&lt;/b&gt;&lt;br&gt;&lt;br&gt;車両写真 / QR / VIN画像&lt;br&gt;ブラウザのファイル入力" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#dcfce7;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="35" y="505" width="250" height="110" as="geometry"/></mxCell><mxCell id="print" value="&lt;b&gt;印刷&lt;/b&gt;&lt;br&gt;&lt;br&gt;車両ラベル・QRコード&lt;br&gt;window.print()" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#e2e8f0;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="35" y="705" width="250" height="100" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;画面・ユーザー操作&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;React 19 + React DOM + TypeScript&lt;/b&gt;&lt;br&gt;Dashboard / 在庫一覧 / ヤードマップ&lt;br&gt;入庫登録 / QRスキャナー / 車両詳細" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#dbeafe;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="380" y="155" width="490" height="145" as="geometry"/></mxCell><mxCell id="state" value="&lt;b&gt;在庫・画面状態&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;App + React Hooks&lt;/b&gt;&lt;br&gt;Vehicle[] / 画面遷移 / 車両登録・配置更新&lt;br&gt;Excel取込の追加 / 出庫時の削除" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#dbeafe;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="380" y="365" width="490" height="125" as="geometry"/></mxCell><mxCell id="xlsx" value="&lt;b&gt;Excel取込&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;SheetJS（xlsx）&lt;/b&gt;&lt;br&gt;シート読み込み → Vehicle[]" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#dcfce7;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="380" y="550" width="225" height="110" as="geometry"/></mxCell><mxCell id="ai" value="&lt;b&gt;画像解析の呼び出し&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;@google/genai&lt;/b&gt;&lt;br&gt;写真の入力補助 / QR・VIN認識" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#fef3c7;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="645" y="550" width="225" height="110" as="geometry"/></mxCell><mxCell id="store" value="&lt;b&gt;端末内の保存先&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;localStorage&lt;/b&gt;&lt;br&gt;yard_manager_vehicles&lt;br&gt;車両配列をJSONで保存・復元" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#dcfce7;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="380" y="720" width="490" height="125" as="geometry"/></mxCell><mxCell id="gemini" value="&lt;b&gt;Google Gemini API&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;gemini-3-flash-preview&lt;/b&gt;&lt;br&gt;車両写真 → 車種・色・年式など&lt;br&gt;QR / VIN画像 → 識別情報" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#fef3c7;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="985" y="505" width="340" height="135" as="geometry"/></mxCell><mxCell id="qr" value="&lt;b&gt;QR画像生成API&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;api.qrserver.com&lt;/b&gt;&lt;br&gt;車両ID・VIN・メーカー・モデル&lt;br&gt;→ QRコード画像" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#fef3c7;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="985" y="305" width="340" height="125" as="geometry"/></mxCell><mxCell id="cdn" value="&lt;b&gt;表示用の外部リソース&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Tailwind CSS CDN&lt;/b&gt;&lt;br&gt;&lt;b&gt;Google Fonts&lt;/b&gt;&lt;br&gt;スタイル・フォントを読み込み" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#fef3c7;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="985" y="125" width="340" height="115" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;開発・ビルド&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Node.js + npm / Vite 6 + @vitejs/plugin-react&lt;/b&gt;&lt;br&gt;TypeScript 5.8 → Reactアプリをビルド → dist/（HTML・JS）&lt;br&gt;開発時はViteサーバー :3000。本番の配信先はリポジトリ内に指定なし。" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#ede9fe;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="35" y="965" width="800" height="135" as="geometry"/></mxCell><mxCell id="checks" value="&lt;b&gt;品質確認&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TypeScript（型チェック）&lt;/b&gt;&lt;br&gt;&lt;b&gt;ESLint（静的解析）&lt;/b&gt;&lt;br&gt;&lt;b&gt;Vitest（ユニットテスト）&lt;/b&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=10;fontSize=14;fillColor=#ede9fe;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="890" y="965" width="435" height="135" as="geometry"/></mxCell><mxCell id="e0" value="画面操作" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="ファイル読込" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="excel" target="xlsx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="画像データ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="photo" target="ai"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="車両データを追加" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="xlsx" target="state"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="操作・表示" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ui" target="state"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="保存 / 復元" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state" target="store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="画像送信 / 解析結果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ai" target="gemini"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="QR内容送信 / 画像取得" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ui" target="qr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="CSS / フォント" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cdn" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="QRを表示して印刷" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ui" target="print"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="ビルド済みアプリ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="build" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;実行時の補足&lt;/b&gt;　lucide-react：画面アイコン。車両データは端末のlocalStorageに保存。バックエンド・DB・端末間同期は現行実装にありません。&lt;br&gt;&lt;b&gt;凡例&lt;/b&gt;　青：アプリ処理　緑：データ取込・保存　黄：外部連携　紫：開発ツール　実線：実行時の入出力　破線：開発・ビルド" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="1135" width="1290" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
